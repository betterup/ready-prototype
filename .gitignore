# Dependencies
node_modules/

# Build output
dist/

# Local environment. .env.example IS committed on purpose — it is all comments
# and documents the coach-proxy contract. Never put a real key in src/ or in a
# VITE_* variable: Vite inlines those into the client bundle.
.env
.env.local
.env.*.local

# Local editor/harness config. launch.json points the preview at the dev
# server, but the port is a local choice — keep it out of the repo.
.claude/
