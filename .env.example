# Optional. Leave unset for the shareable default: the in-browser scripted coach.
#
# Point this at a SERVER-SIDE endpoint that holds the Anthropic key and forwards
# to the API. Contract:
#   POST { messages: [{ role: 'user' | 'assistant', content: string }] }
#   200  { reply: string }
#
# Never put an API key in this file or anywhere else in src/. Vite inlines every
# VITE_* value into the client bundle, so a key here is readable by anyone who
# opens the prototype.
# VITE_COACH_PROXY_URL=https://your-internal-proxy.betterup.co/coach
